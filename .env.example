# Production settings. Copy to .env next to docker-compose.yml. Only startup parameters live
# here: everything configured in the setup wizard or admin panel is stored in the database.

# --- Compose -----------------------------------------------------------------
# Image tag to run (e.g. 0.1.0). Required; scripts/deploy.sh keeps it up to date.
APP_VERSION=
# Registry/name prefix of the images (forks, local registries). Default: ghcr.io/ivanerricis/easysend
# IMAGE_PREFIX=ghcr.io/ivanerricis/easysend
# Use only the production file (never auto-load docker-compose.override.yml, which builds locally).
COMPOSE_FILE=docker-compose.yml
# Start the Cloudflare tunnel container.
COMPOSE_PROFILES=tunnel
# Where the web container is published on the host. Loopback lets you reach the setup
# wizard through an SSH tunnel before Cloudflare is configured.
# WEB_BIND=127.0.0.1
# WEB_PORT=8080

# --- Application -------------------------------------------------------------
# local | production
# APP_MODE=production
# Set by the wizard in production; required to override it (e.g. http://localhost:8080 locally).
# PUBLIC_URL=
# TZ=Europe/Rome
# LOG_LEVEL=info
# Dev only: human-readable (pino-pretty) logs instead of JSON. Leave unset in production.
# LOG_PRETTY=false
# Proxy hops in front of the api: 1 = nginx only (local), 2 = cloudflared + nginx (production).
# TRUST_PROXY=2
# Local mode only: SMTP server (Mailpit) used when no SMTP settings are stored in the database.
# The local compose file and `pnpm dev` set these for you.
# SMTP_DEV_HOST=
# SMTP_DEV_PORT=
# Cloudflare API base URL. For automated tests only (E2E points it at a fake server); never set it in production.
# CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
# Where the admin update notice looks for releases (GitHub "list releases" API format).
# For automated tests only, or to point to a mirror; the default is the GitHub releases API.
# UPDATE_CHECK_URL=https://api.github.com/repos/ivanerricis/easysend/releases?per_page=30

# --- Data location -----------------------------------------------------------
# Where the database, encrypted files, branding and secrets are stored on the host. Empty (the
# default) uses the Docker volume `easysend-data`. To use a folder or another disk instead, set an
# ABSOLUTE path (no trailing slash, no ':'). The folder must exist and be owned by uid/gid 1000
# (the api user), or the api cannot start. Create it with:
#   sudo install -d -o 1000 -g 1000 /mnt/dati/easysend
# scripts/deploy.sh checks it before touching the running stack. Existing data is NOT moved: see
# https://ivanerricis.github.io/easysend/guide/data-location
# DATA_PATH=/mnt/dati/easysend

# --- Paths (inside the containers; change only if you know why) --------------
# DB_PATH=/data/db/app.sqlite
# STORAGE_DIR=/data/storage
# TMP_UPLOAD_DIR=/data/tmp
# BRANDING_DIR=/data/branding

# --- Secrets (optional) ------------------------------------------------------
# If unset, both are generated on first start under /data/secrets (mode 600).
# BACK UP /data/secrets: without APP_SECRET_KEY, files, TOTP secrets and the SMTP password
# become unreadable. Never commit real values.
# APP_SECRET_KEY=
# SESSION_SECRET=

# --- File storage (optional) ----------------------------------------------------
# Read ONLY at the first start: leave everything empty to store files on the server disk. When
# STORAGE_DRIVER=s3 the configuration below is imported into the database (encrypted) and from
# then on it is managed in the app (wizard or Settings > Storage); changing these variables later
# has no effect and the settings page warns you that they differ.
# STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=easysend
# S3_PREFIX=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# Secret key: either the value or a file (absolute, or relative to /data/secrets). Never commit it.
# S3_SECRET_ACCESS_KEY=
# S3_SECRET_ACCESS_KEY_FILE=

# --- Tuning ------------------------------------------------------------------
# SETUP_CODE_TTL_MINUTES=60
# PASSWORD_RESET_TTL_MINUTES=30
# LOG_RETENTION_DAYS=90
# INCOMPLETE_UPLOAD_TTL_HOURS=24
# CLEANUP_CRON="0 * * * *"
# Used only before the wizard has run:
# DEFAULT_DISK_RESERVE_MB=1024
# DEFAULT_CHUNK_SIZE_MB=25
