{
  "name": "easysend",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted large file transfer web application",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "test:mailpit": "node scripts/test-mailpit.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "build": "pnpm -r --if-present --filter \"!@easysend/docs\" run build",
    "db:generate": "pnpm --filter @easysend/api run db:generate",
    "db:migrate": "pnpm --filter @easysend/api run db:migrate",
    "user:create-admin": "pnpm --filter @easysend/api run user:create-admin --",
    "key:rotate": "pnpm --filter @easysend/api run key:rotate --",
    "mail:preview": "pnpm --filter @easysend/api run mail:preview",
    "db:check": "pnpm run db:generate && git diff --exit-code apps/api/drizzle",
    "api:docs": "pnpm --filter @easysend/shared run docs:generate",
    "api:docs:check": "pnpm --filter @easysend/shared run docs:generate --check",
    "local:up": "node scripts/local.mjs up",
    "local:down": "node scripts/local.mjs down",
    "local:reset": "node scripts/local.mjs reset",
    "screenshots": "node scripts/screenshots.mjs",
    "docs:dev": "pnpm --filter @easysend/docs run dev",
    "docs:build": "pnpm --filter @easysend/docs run build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
