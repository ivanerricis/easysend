# Ready-to-use settings for the local try-out (`pnpm local:up` copies this to .env.local).
# PUBLIC_URL is derived from LOCAL_WEB_PORT by docker-compose.local.yml.
APP_VERSION=local
APP_MODE=local
TRUST_PROXY=1
LOG_LEVEL=debug

# Host ports. Uncomment and change only if another project already uses the default.
# Full Docker stack (`pnpm local:up`):
# LOCAL_WEB_PORT=8080
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# Hot-reload development (`pnpm dev`, which also uses the Mailpit ports above):
# DEV_API_PORT=3000
# DEV_WEB_PORT=5173
